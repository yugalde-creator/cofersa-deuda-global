# Google OAuth (get from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=https://your-vercel-domain.vercel.app
NEXTAUTH_SECRET=your_random_secret_here

# Google Sheets Service Account (paste full service-account.json content on one line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Google Spreadsheet ID (from the URL: docs.google.com/spreadsheets/d/THIS_PART/edit)
SPREADSHEET_ID=1WXw5-pbPqVtxG4BeaCe9C2wfx_ChrnnRV9dbf9x9kpcQ